# Copia questo file in .env.local e compila i valori del tuo progetto Supabase.
# Senza queste variabili la partita locale funziona comunque:
# restano disabilitate solo le stanze online, la condivisione delle categorie e la votazione.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dominio pubblico mostrato nella card e usato nei link di voto (senza slash finale).
NEXT_PUBLIC_SITE_URL=

# Profilo social mostrato nel menu.
NEXT_PUBLIC_INSTAGRAM_URL=

# Chiave della modalità creatore: sblocca Studio ed editor delle categorie.
# Se resta vuota lo Studio è accessibile solo in sviluppo.
NEXT_PUBLIC_ADMIN_KEY=

# Donazioni: utente Revolut (default acrisci05) e, quando disponibile, utente PayPal.me.
# Finché NEXT_PUBLIC_PAYPAL_USER resta vuoto il pulsante PayPal appare come "in arrivo".
NEXT_PUBLIC_REVOLUT_USER=
NEXT_PUBLIC_PAYPAL_USER=
