# Copia questo file in .env.local e compila i valori del tuo progetto Supabase.
# Senza queste variabili la partita locale funziona comunque:
# restano disabilitate solo le stanze online, la condivisione delle categorie e la votazione.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dominio pubblico mostrato nella card e usato nei link di voto (senza slash finale).
NEXT_PUBLIC_SITE_URL=

# Profilo social mostrato nel menu.
NEXT_PUBLIC_INSTAGRAM_URL=

# Chiave della modalità creatore: sblocca Studio ed editor delle categorie.
# La parola la scegli tu. Se resta vuota lo Studio è aperto in sviluppo e chiuso online.
NEXT_PUBLIC_ADMIN_KEY=

# Donazioni: utente Revolut e utente PayPal.me. Lasciandoli vuoti valgono i profili
# del creatore (acrisci05 su entrambi); si cambiano qui senza toccare il codice.
# Da qui non passa nessun pagamento: i pulsanti aprono il profilo sul servizio esterno.
NEXT_PUBLIC_REVOLUT_USER=
NEXT_PUBLIC_PAYPAL_USER=

# Manutenzione: "true" chiude il sito a tutti tranne a chi ha la chiave del
# creatore, che continua a vederlo per intero. Serve prima di un aggiornamento
# importante: si cambia questo valore e si ripubblica.
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Foto degli elementi da Unsplash, per le cose che Wikipedia non documenta.
# Gratuita su unsplash.com/developers. Serve solo a "npm run images:fetch",
# che scrive gli indirizzi trovati dentro data/categories.json: al sito
# pubblicato non serve, e infatti non ha il prefisso NEXT_PUBLIC_.
# Senza, restano Wikipedia e Wikimedia Commons.
UNSPLASH_ACCESS_KEY=""

# Locandine di film e serie (themoviedb.org) e copertine di videogiochi
# (rawg.io). Sono i due mondi che gli archivi liberi non possono coprire,
# perche' quelle immagini sono protette. Gratuite, e servono solo a
# "npm run images:fetch": al sito pubblicato non arrivano.
TMDB_API_KEY=""
RAWG_API_KEY=""

# Notifiche su Telegram quando arriva un suggerimento.
# Niente prefisso NEXT_PUBLIC_: restano sul server e non finiscono mai nel
# browser. Con il token in chiaro nella pagina chiunque potrebbe scriverti.
# Il token lo dà @BotFather; il codice della chat lo trova "npm run telegram".
# Lasciandoli vuoti il suggerimento si salva lo stesso, senza avviso.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
