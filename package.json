{
  "name": "draft-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:engine": "tsc -p tsconfig.check.json && node scripts/engine-check.js .tmp-check/lib",
    "check:multiplayer": "tsc -p tsconfig.check.json && node scripts/multiplayer-check.js",
    "check:rooms": "node scripts/room-check.js http://localhost:3000",
    "check:supabase": "node scripts/supabase-check.js",
    "check:images": "tsc -p tsconfig.check.json && node scripts/images-check.js",
    "check:photos": "node scripts/check-photos.js",
    "check:layout": "node scripts/check-layout.js http://localhost:3000 390 9333",
    "share": "npx --yes cloudflared tunnel --url http://localhost:3000",
    "telegram": "node scripts/telegram-setup.js",
    "images:fetch": "tsc -p tsconfig.check.json && node scripts/fetch-images.js",
    "images:fix": "node scripts/fix-images.js",
    "images:sheet": "node scripts/contact-sheet.js",
    "docs:pdf": "node scripts/build-guide-pdf.js",
    "check:levels": "tsc -p tsconfig.check.json && node scripts/levels-check.js",
    "check:tiebreak": "tsc -p tsconfig.check.json && node scripts/tiebreak-check.js",
